{
  "schema": "omc-placement-contract/1",
  "node_types": [
    "AcceptanceTest",
    "Capability",
    "Executor",
    "Invariant",
    "Source",
    "Stage",
    "Subject"
  ],
  "predicates": {
    "HAS_CAPABILITY": {
      "domain": [
        "Subject"
      ],
      "range": [
        "Capability"
      ],
      "out_min": 1,
      "out_max": null,
      "meaning": "Subject has this user-requested capability; does not exhaust its identity.",
      "in_min": 0,
      "in_max": null
    },
    "PRESERVES": {
      "domain": [
        "Capability"
      ],
      "range": [
        "Invariant"
      ],
      "out_min": 1,
      "out_max": null,
      "meaning": "An accepted physical placement must keep this invariant.",
      "in_min": 0,
      "in_max": null
    },
    "IMPLEMENTED_BY": {
      "domain": [
        "Capability"
      ],
      "range": [
        "Stage"
      ],
      "out_min": 1,
      "out_max": null,
      "meaning": "The bounded implementation includes this stage, not unrestricted autonomy.",
      "in_min": 0,
      "in_max": null
    },
    "USES_EXECUTOR": {
      "domain": [
        "Stage"
      ],
      "range": [
        "Executor"
      ],
      "out_min": 0,
      "out_max": null,
      "meaning": "Stage delegates to the existing owner tool; no authority is inferred.",
      "in_min": 0,
      "in_max": null
    },
    "TESTED_BY": {
      "domain": [
        "Capability"
      ],
      "range": [
        "AcceptanceTest"
      ],
      "out_min": 1,
      "out_max": null,
      "meaning": "Test definitions exercise the capability; execution evidence is recorded separately.",
      "in_min": 0,
      "in_max": null
    },
    "DERIVED_FROM": {
      "domain": [
        "Capability"
      ],
      "range": [
        "Source"
      ],
      "out_min": 1,
      "out_max": null,
      "meaning": "The interpretation derives from an identified source, not a new user utterance.",
      "in_min": 0,
      "in_max": null
    }
  }
}
