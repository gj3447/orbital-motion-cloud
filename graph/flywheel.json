    {
      "uid": "omc:flywheel:claim:premise",
      "type": "Claim",
      "label": "동일 모델과 총토큰 예산에서 HSWM·CHU의 답변 효용이 단독 사용보다 높다",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "epistemic_state": "HYPOTHESIS",
      "qualification": "원문을 실험 가능한 전제로 정식화한 가설. 과제별 우위를 검증하며 초지능 입증을 뜻하지 않는다.",
      "actor": "OpenAI Codex"
    },
    {
      "uid": "omc:flywheel:claim:economy",
      "type": "Claim",
      "label": "유용한 공동 지능의 수요가 합의한 자원 기여를 유도한다",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "epistemic_state": "HYPOTHESIS",
      "qualification": "서비스 가치가 가격·지연·기여 비용을 고려한 대안보다 유용해야 한다.",
      "actor": "OpenAI Codex"
    },
    {
      "uid": "omc:flywheel:claim:capacity",
      "type": "Claim",
      "label": "검증된 기여가 가용 풀과 유용한 조직 능력을 확장한다",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "epistemic_state": "HYPOTHESIS",
      "qualification": "실제 사용 가능한 자원과 조직 개선이 늘어야 하며 공칭 하드웨어 수만 세지 않는다.",
      "actor": "OpenAI Codex"
    },
    {
      "uid": "omc:flywheel:claim:learning",
      "type": "Claim",
      "label": "검증된 이용 경험이 다음 질의의 조직과 효용을 개선한다",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "epistemic_state": "HYPOTHESIS",
      "qualification": "정답 누출·오염·반복 오류를 배제하고 별도 과제에서 재현해야 한다.",
      "actor": "OpenAI Codex"
    },
    {
      "uid": "omc:flywheel:claim:settlement",
      "type": "Claim",
      "label": "MHC 기반 크레딧이 검증된 기여 대가와 공동 지능 소비를 연결한다",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "epistemic_state": "HYPOTHESIS",
      "qualification": "자원 단위·기여 검증·정산 및 서비스 제공 조건이 필요하다. MHC와 크레딧의 비율은 미정이다.",
      "actor": "OpenAI Codex"
    },
    {
      "uid": "omc:flywheel:metric:utility",
      "type": "Metric",
      "label": "동일 모델과 총토큰 상한의 효용 차이",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "definition": "mean U(C,B) - mean U(A,B); secondary sum(U)/sum(T_total)",
      "units": "task-score; task-score/token",
      "accounting": "All LLM input/output across agents, routing, summaries, verification, failed calls and retries; reasoning included once; cached input counted logically. Unknown hidden usage blocks exact token comparison.",
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:metric:demand",
      "type": "Metric",
      "label": "재이용과 자발적 기여",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "definition": "repeat service usage; contribution retention; withdrawal",
      "units": "counts; fraction",
      "accounting": "Use observed service consumption, not speculative MHC trading.",
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:metric:supply",
      "type": "Metric",
      "label": "검증된 자원 가용성",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "definition": "verified CPU/GPU time; memory-time; useful completions",
      "units": "seconds; byte-seconds; count",
      "accounting": "Track hardware classes and availability separately; do not add unlike resource units.",
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:metric:update",
      "type": "Metric",
      "label": "경험 갱신의 개선 효과",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "definition": "held-out utility delta with and without validated experience",
      "units": "task-score",
      "accounting": "Separate training and evaluation data; include construction and update costs.",
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:metric:redemption",
      "type": "Metric",
      "label": "기여 대가의 서비스 이용 실현",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "definition": "completed service redemptions / attempted eligible redemptions",
      "units": "fraction",
      "accounting": "Track quote, available supply, actual service and settlement; not an established exchange rate.",
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:evaluation:fixed-budget",
      "type": "Evaluation",
      "label": "단독 사용과 일반 검색 및 HSWM·CHU 비교",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "status": "PLANNED",
      "result": null,
      "conditions": [
        "same model revision and tokenizer",
        "same tasks and scoring; fixed total token budget caps",
        "B and C use identical source snapshots and access scope",
        "report actual tokens, cold-start and amortized preparation costs",
        "predeclare sample size, minimum effect, uncertainty method and latency limits"
      ],
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:evaluation:participation",
      "type": "Evaluation",
      "label": "유용성에 따른 기여와 재이용 관측",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "status": "PLANNED",
      "result": null,
      "conditions": [
        "observe actual service consumption and contribution costs",
        "separate supplier and consumer roles; record exit"
      ],
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:evaluation:capacity",
      "type": "Evaluation",
      "label": "공칭 제공량과 실제 처리량 비교",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "status": "PLANNED",
      "result": null,
      "conditions": [
        "verify resource class, availability and completed useful work",
        "measure selection and scheduling overhead"
      ],
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:evaluation:ablation",
      "type": "Evaluation",
      "label": "기억과 조직의 기여 분리",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "status": "PLANNED",
      "result": null,
      "conditions": [
        "hold model, budget and corpus fixed",
        "remove one component at a time",
        "measure held-out regressions and preparation costs"
      ],
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
    {
      "uid": "omc:flywheel:evaluation:settlement",
      "type": "Evaluation",
      "label": "검증된 기여에서 실제 서비스 소비까지 확인",
      "authority": "SECONDARY_AI",
      "record_lifecycle": "PROPOSED",
      "status": "PLANNED",
      "result": null,
      "conditions": [
        "define resource unit, verification, settlement and refund rules first",
        "record completed service delivery and balances"
      ],
      "source_refs": [
        "omc:flywheel:source:design"
      ]
    },
