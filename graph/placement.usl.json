  "meanings": [
    {
      "id": "omc:placement:predicate:HAS_CAPABILITY",
      "description": "Subject has this user-requested capability; does not exhaust its identity."
    },
    {
      "id": "omc:placement:predicate:PRESERVES",
      "description": "An accepted physical placement must keep this invariant."
    },
    {
      "id": "omc:placement:predicate:IMPLEMENTED_BY",
      "description": "The bounded implementation includes this stage, not unrestricted autonomy."
    },
    {
      "id": "omc:placement:predicate:USES_EXECUTOR",
      "description": "Stage delegates to the existing owner tool; no authority is inferred."
    },
    {
      "id": "omc:placement:predicate:TESTED_BY",
      "description": "Test definitions exercise the capability; execution evidence is recorded separately."
    },
    {
      "id": "omc:placement:predicate:DERIVED_FROM",
      "description": "The interpretation derives from an identified source, not a new user utterance."
    }
