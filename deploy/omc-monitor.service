[Unit]
Description=OMC bounded DGX hardware and vLLM observation
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=%h/.local/bin/omc-monitor collect --json
TimeoutStartSec=45
TimeoutStopSec=5
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=32
Nice=10
UMask=0077
NoNewPrivileges=true
StandardOutput=null
StandardError=journal
SyslogIdentifier=omc-monitor
